{
  "name": "authshift",
  "version": "1.0.0",
  "description": "Instant 1-click auth, cookie & localStorage switcher for web developers and QA testing",
  "author": "Subodh Khanal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosubodh/authshift.git"
  },
  "bugs": {
    "url": "https://github.com/prosubodh/authshift/issues"
  },
  "homepage": "https://github.com/prosubodh/authshift#readme",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "icons": "python scripts/generate_icons.py",
    "pack": "npm run build && powershell -Command \"Compress-Archive -Path dist\\* -DestinationPath authshift.zip -Force\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
